{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create product response",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "title",
    "price",
    "category"
  ],
  "additionalProperties": false
}
